    "annotation",
    "image",
    "fabric",
    "canvas",
    "mark-image"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "fabric": "^4.5.0",
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@vitejs/plugin-vue": "^5.2.4",
    "fabric": "^4.6.0",
    "less": "^4.3.0",
    "vite": "^6.3.5",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vue": "^3.5.13"
  },
  "engines": {
    "node": ">=18"
