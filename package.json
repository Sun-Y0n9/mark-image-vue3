{
  "name": "@mark-image/vue3",
  "version": "0.1.0",
  "description": "Vue 3 image annotation canvas: pen, rect, circle, zoom, pan and rotate.",
  "type": "module",
  "main": "./dist/mark-image.cjs",
  "module": "./dist/mark-image.js",
  "unpkg": "./dist/mark-image.umd.js",
